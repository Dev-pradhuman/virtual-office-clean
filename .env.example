# ===========================================================================
# Virtual Office — environment template
# Copy this file to ".env" and fill in your own values:
#     cp .env.example .env
# The real ".env" is gitignored and must NEVER be committed.
# ===========================================================================

# --- Auth (REQUIRED) -------------------------------------------------------
# Secret used to sign/verify login tokens. Generate your own with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# On Render, set this as an environment variable so logins survive restarts.
JWT_SECRET=replace-with-a-long-random-string

# --- Networking (REQUIRED) -------------------------------------------------
# Comma-separated origins allowed to call the backend / open a socket.
# Include the desktop app origin (http://localhost:3000) and your deployed URL.
ALLOWED_ORIGINS=http://localhost:3000,https://YOUR-APP.onrender.com

# Optional: local port the app + backend use. Defaults to 3000. Change this if
# 3000 is taken by another project (e.g. PORT=3001) — the Electron windows and
# the localhost CORS origin both follow this automatically. Render sets it itself.
# PORT=3000

# --- Persistent database (OPTIONAL but recommended on Render) ---------------
# Without these the app uses a local SQLite file (office.db), which Render wipes
# on every deploy. Set both to a free Turso (libSQL) database so messages,
# tasks, whiteboard and stats persist across deploys:
#   turso db create v-office
#   turso db show v-office --url       -> TURSO_DATABASE_URL (libsql://...)
#   turso db tokens create v-office    -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- WebRTC TURN (OPTIONAL — fixes call/screen-share lag across networks) ---
# The free public TURN is overloaded; point at your own for low latency.
# Either a JSON array of ICE servers:
#   TURN_SERVERS=[{"urls":"turn:host:3478","username":"u","credential":"p"}]
# ...or the simple trio (comma-separate multiple urls in TURN_URL):
# TURN_URL=turn:your.turn.host:3478
# TURN_USERNAME=
# TURN_PASSWORD=

# --- Admin (OPTIONAL but recommended) --------------------------------------
# The username allowed to open the in-app Settings panel and configure API
# keys (e.g. Google Drive). No one is admin unless you set this. Must match an
# existing username. Applied on every server boot, so it works on an existing
# database too.
ADMIN_USERNAME=

# --- Google Drive file uploads (OPTIONAL) ----------------------------------
# You normally DO NOT need these here — the admin sets them in the app under
# Settings, and they're stored on the server. These env vars only act as a
# fallback if you'd rather not use the UI.
#   1. Google Cloud Console -> Credentials -> Create OAuth client ID (Desktop)
#   2. Run: node auth_setup.js  (follow the link, paste the code) to get a token
#   3. Enter the client id/secret, refresh token and folder id in-app (Settings)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
